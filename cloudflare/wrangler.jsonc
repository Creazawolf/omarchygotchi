{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omarchy-creature-community",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omarchy-creature-community",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "84621001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "USER_LIMIT",
      "namespace_id": "84621002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "JOIN_LIMIT",
      "namespace_id": "84621003",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "REGISTRATION_OPEN": "true",
    "MAX_PROFILES": "1000"
  }
}
